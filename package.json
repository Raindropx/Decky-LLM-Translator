{
  "name": "decky-llm-translator",
  "version": "0.5.1",
  "type": "module",
  "description": "Translate on-screen game text with configurable LLM endpoints while preserving OCR-based positioning.",
  "scripts": {
    "build": "shx rm -rf dist && rollup -c",
    "watch": "rollup -c -w",
    "test": "node --test tests/i18n.test.mjs tests/translation-cache.test.mjs tests/ask-ai-state.test.mjs tests/overlay-layer.test.mjs",
    "build:deck": "wsl -e sh -c \"rm -rf out node_modules && ./cli/decky plugin build . -o ./out\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raindropx/Decky-LLM-Translator.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "translation",
    "language-learning",
    "steam-deck",
    "deck"
  ],
  "author": "Raindropx",
  "license": "GNU GPLv3",
  "bugs": {
    "url": "https://github.com/Raindropx/Decky-LLM-Translator/issues"
  },
  "homepage": "https://github.com/Raindropx/Decky-LLM-Translator",
  "devDependencies": {
    "@decky/api": "^1.1.3",
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.11.1",
    "@rollup/plugin-sucrase": "5.1.0",
    "@types/react": "16.14.0",
    "@types/react-dom": "^19.1.2",
    "@types/webpack": "^5.28.0",
    "rollup": "^4.24.0",
    "shx": "^0.3.4",
    "tslib": "^2.4.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0",
    "react-icons": "^4.4.0",
    "react-markdown": "8.0.7",
    "remark-gfm": "3.0.1"
  },
  "remote_binary": [
    {
      "name": "plugin-dependencies.tar.gz",
      "url": "https://github.com/Raindropx/Decky-LLM-Translator/releases/download/v0.5.0/plugin-dependencies.tar.gz",
      "sha256hash": "95bbd890cf07d5f46c67fbee3ebc8234893bc568b14b6942bf312bad6ce7a086"
    }
  ]
}
